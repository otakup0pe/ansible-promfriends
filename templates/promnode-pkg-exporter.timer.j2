# {{ ansible_managed }}
[Unit]
Description=run promfriend node pkg-exporter on schedule

[Timer]
OnActiveSec={{ promnode_pkg_exporter_onactivesec }}
OnCalendar={{ promnode_pkg_exporter_oncalendar }}{{ ' ' ~ promnode_pkg_exporter_timezone if promnode_pkg_exporter_timezone | default('', true) else '' }}
AccuracySec={{ promnode_pkg_exporter_accuracysec }}
Persistent=true
Unit=promnode-pkg-exporter.service

[Install]
WantedBy=timers.target
