---  # -*-YAML-*- {{ansible_managed}}
tls_server_config:
  cert_file: "{{alertmanager_cluster_tls_cert}}"
  key_file: "{{alertmanager_cluster_tls_key}}"
  client_ca_file: "{{alertmanager_cluster_tls_ca}}"
  client_auth_type: "RequireAndVerifyClientCert"
tls_client_config:
  ca_file: "{{alertmanager_cluster_tls_ca}}"
  cert_file: "{{alertmanager_cluster_tls_cert}}"
  key_file: "{{alertmanager_cluster_tls_key}}"
{% if alertmanager_cluster_tls_server_name %}
  server_name: "{{alertmanager_cluster_tls_server_name}}"
{% endif %}
